{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhanjas.com/schema/recipe.schema.json",
  "title": "dhanjas.com recipe",
  "description": "One recipe in the dhanjas.com house format — the v2 recipe template as data. Field-by-field notes: docs/RECIPE-FORMAT.md. Inline text may use {amount} (amber per-step amount, scales with the batch; {=amount} never scales) and **bold**.",
  "type": "object",
  "required": ["slug", "category", "title", "subtitle", "ingredientGroups", "method"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "slug": {
      "type": "string",
      "pattern": "^(breakfast|curry|dal|rice|bread|snack|chaat|powder|sweet|drink)-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "<category>-<dish>; the page lives at /recipes/<slug>.html"
    },
    "category": {
      "type": "string",
      "enum": ["breakfast", "curry", "dal", "rice", "bread", "snack", "chaat", "powder", "sweet", "drink"],
      "description": "Must match the slug prefix. Drives the Type filter."
    },
    "title": {"type": "string", "minLength": 1, "description": "<h1> and recipe name"},
    "name": {"type": "string", "description": "Recipe-name heading, only when it differs from the title"},
    "subtitle": {"type": "string", "minLength": 1, "description": "One line under the title; card blurb"},
    "badges": {"type": "array", "items": {"type": "string"}, "description": "Header pills, e.g. Jain Vegetarian, Toddler-adapted"},
    "labels": {"type": "array", "items": {"type": "string"}, "description": "The recipe-tag pill above the name, e.g. \"Paneer · Curry\""},
    "meta": {
      "type": "array", "items": {"type": "string"},
      "description": "Times and yield, e.g. \"Morning: 25 min\", \"Makes 6–7 chillas\". Yield numbers scale with the batch; times don't."
    },
    "protein": {"type": ["string", "null"], "description": "Protein bar, e.g. \"~18–22g protein per adult serving\""},
    "nightPrep": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "required": ["label", "items"], "additionalProperties": false,
          "properties": {
            "label": {"type": "string", "description": "Shown after 🌙, e.g. Night Before"},
            "items": {"type": "array", "items": {"type": "string"}, "minItems": 1}
          }
        }
      ]
    },
    "ingredientsTitle": {"type": "string", "description": "Only when not \"Ingredients\""},
    "methodTitle": {"type": "string", "description": "Only when not \"Method\""},
    "ingredientGroups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["label", "items"], "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "items": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["name", "amount"], "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "amount": {
                  "type": "string", "minLength": 1,
                  "description": "Leads with a quantity the batch control can scale (\"1½ cups\", \"2–3\", \"200g\"), or is a phrase like \"to taste\". Per-piece amounts (\"1 tsp per chilla\") stay fixed."
                }
              }
            }
          }
        }
      }
    },
    "method": {
      "type": "array", "minItems": 1,
      "description": "In page order. Steps are numbered automatically; toddler boxes go at the exact moment her portion is pulled.",
      "items": {
        "oneOf": [
          {
            "type": "object", "required": ["type", "title", "items"], "additionalProperties": false,
            "properties": {
              "type": {"const": "step"},
              "title": {"type": "string"},
              "items": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          },
          {
            "type": "object", "required": ["type", "label", "items"], "additionalProperties": false,
            "properties": {
              "type": {"const": "toddler"},
              "label": {"type": "string", "description": "Shown after 👶"},
              "items": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          },
          {
            "type": "object", "required": ["type", "text"], "additionalProperties": false,
            "properties": {
              "type": {"const": "tip"},
              "label": {"type": "string", "default": "Tip"},
              "text": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {"enum": ["Quick", "Night prep", "Meal prep", "High-protein", "No-cook", "Instant Pot", "Air fryer", "Oven"]},
      "uniqueItems": true,
      "description": "Front-page filters — fixed list. Detected on import; can be added by hand."
    },
    "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
