{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Paneer Bhurji",
  "description": "Creamy scrambled paneer with tomato and capsicum — a fast, high-protein weekday breakfast.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Breakfast",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Paneer, Night prep, High-protein, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "400g Paneer, crumbled",
    "2 medium Tomatoes, finely chopped",
    "1 medium Capsicum, diced",
    "1½ tsp Fresh ginger, grated",
    "1–2 (adults) Green chili, chopped",
    "2 tbsp Ghee or butter",
    "1 tsp Cumin seeds",
    "¼ tsp Hing",
    "¼ tsp Turmeric",
    "½ tsp Kashmiri red chili powder",
    "1 tsp Coriander powder",
    "½ tsp Cumin powder",
    "¼ tsp Garam masala",
    "1 tsp Kasuri methi, crushed",
    "2 tbsp Fresh coriander, chopped",
    "½ tsp Lemon juice, optional",
    "2 per adult Whole wheat roti or toast"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Night Before (optional)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Crumble paneer and refrigerate"
        },
        {
          "@type": "HowToStep",
          "text": "Chop capsicum, tomato, coriander; refrigerate in a small container"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Toddler portion first",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Set aside crumbled paneer (100g), capsicum (2 tbsp), tomato (2 tbsp)"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler cooking (~5 min, do first)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat small pan on low; add butter (½ tsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Add cumin seeds (pinch), let splutter"
        },
        {
          "@type": "HowToStep",
          "text": "Add tomato and capsicum (2 tbsp each); cook 2 min until soft"
        },
        {
          "@type": "HowToStep",
          "text": "Add paneer (100g), pinch turmeric, pinch salt; stir 1–2 min — keep moist"
        },
        {
          "@type": "HowToStep",
          "text": "Optional: mash in ½ boiled potato for extra calories"
        },
        {
          "@type": "HowToStep",
          "text": "Serve with soft roti or toast soldiers"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Build the base",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat ghee (2 tbsp) in a wide pan on medium-high"
        },
        {
          "@type": "HowToStep",
          "text": "Add cumin seeds (1 tsp); splutter 20 sec"
        },
        {
          "@type": "HowToStep",
          "text": "Add hing (¼ tsp) and ginger (1½ tsp); stir 30 sec"
        },
        {
          "@type": "HowToStep",
          "text": "Add green chili (1–2); cook 20 sec"
        },
        {
          "@type": "HowToStep",
          "text": "Add remaining tomatoes; cook 4–5 min until oil separates"
        },
        {
          "@type": "HowToStep",
          "text": "Add remaining capsicum; stir-fry 2 min, keep slight crunch"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Spice and finish",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add turmeric (¼ tsp), red chili powder (½ tsp), coriander powder (1 tsp), cumin powder (½ tsp), salt to taste; stir 30 sec"
        },
        {
          "@type": "HowToStep",
          "text": "Add remaining paneer (~300g); fold gently — don't mash"
        },
        {
          "@type": "HowToStep",
          "text": "Cook 2–3 min; add garam masala (¼ tsp) and kasuri methi (1 tsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Finish with lemon juice (½ tsp); garnish with coriander (2 tbsp)"
        },
        {
          "@type": "HowToTip",
          "text": "High heat when cooking tomatoes is key — it develops flavor fast. Don't overcook after adding paneer; it should stay soft and moist."
        }
      ]
    }
  ],
  "datePublished": "2026-09-06",
  "recipeYield": "Serves 2 adults + toddler",
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "totalTime": "PT25M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "28–32 g",
    "description": "~28–32g protein per adult serving"
  }
}
