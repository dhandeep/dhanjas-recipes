{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Spiced Chaas",
  "description": "Mint · Roasted cumin · 5 min · 2 adults + toddler",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Drink",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Yogurt, Quick, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "1 cup Plain yogurt (curd)",
    "2 cups Chilled water",
    "½ tsp Roasted cumin powder",
    "½ tsp Black salt (kala namak)",
    "Regular salt, to taste",
    "10–12 Mint leaves",
    "small handful Fresh coriander",
    "½ inch Fresh ginger",
    "½ (adults) Green chili, minced",
    "½ tsp Ghee",
    "1 pinch Hing (asafoetida)",
    "5–6 Curry leaves",
    "1 pinch Black pepper, ground",
    "¼ tsp Chaat masala"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Blend aromatics",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add mint (10–12 leaves), coriander (small handful) and ginger (½ inch) to a blender"
        },
        {
          "@type": "HowToStep",
          "text": "Add yogurt (¼ cup)"
        },
        {
          "@type": "HowToStep",
          "text": "Blend until completely smooth"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Mix chaas",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add remaining yogurt (¾ cup) and chilled water (2 cups)"
        },
        {
          "@type": "HowToStep",
          "text": "Add roasted cumin powder (½ tsp), black salt (½ tsp) and salt (to taste)"
        },
        {
          "@type": "HowToStep",
          "text": "Blend or whisk until light and frothy"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler — pour now, before chili and pepper",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Pour her glass (½ cup) from the chaas"
        },
        {
          "@type": "HowToStep",
          "text": "Optional: stir in a tiny pinch of hing (1 pinch) and serve chilled"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Adult spicing",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Stir green chili (½, minced) and black pepper (1 pinch) into the remaining chaas"
        },
        {
          "@type": "HowToStep",
          "text": "Heat ghee (½ tsp) in a small pan on low"
        },
        {
          "@type": "HowToStep",
          "text": "Add hing (1 pinch) and curry leaves (5–6); sizzle 10 seconds"
        },
        {
          "@type": "HowToStep",
          "text": "Pour the tempering over the chaas; add chaat masala (¼ tsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Chill 15 minutes or serve over ice"
        },
        {
          "@type": "HowToTip",
          "text": "Chaas separates as it sits — whisk again just before pouring."
        }
      ]
    }
  ],
  "datePublished": "2026-10-07",
  "recipeYield": "Makes ~3 cups",
  "prepTime": "PT5M",
  "totalTime": "PT5M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "8 g",
    "description": "~8g protein per batch (~3g per 1-cup glass)"
  }
}
