{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Sambar Powder",
  "description": "A toasted spice and lentil powder — the base for sambar, rasam, and general souring or spicing.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Powders & Chutneys",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Sambar · Spice Blend, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "1½ tbsp Chana dal (bengal gram)",
    "1½ tbsp Urad dal, skinned (black gram)",
    "1 tbsp Toor dal (split pigeon peas)",
    "8–12 Dried red chilies",
    "¼ cup Coriander seeds",
    "¾ tsp Methi seeds (fenugreek)",
    "2 tsp Cumin seeds",
    "1 tsp Black peppercorns, optional",
    "2 sprigs Curry leaves, optional",
    "⅛ tsp Hing",
    "¼ tsp Turmeric powder"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Dry roast in stages",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat a heavy pan on low flame — low heat the whole way through is what brings out the aroma, don't rush this"
        },
        {
          "@type": "HowToStep",
          "text": "Add chana dal (1½ tbsp), urad dal (1½ tbsp), toor dal (1 tbsp), and dried red chilies (8–12); dry roast, stirring often, until the dals turn golden and the chilies darken slightly and smell toasty"
        },
        {
          "@type": "HowToStep",
          "text": "Add coriander seeds (¼ cup) and methi seeds (¾ tsp); roast until the coriander turns crunchy and lightly golden, and the methi turns a shade darker and smells nutty"
        },
        {
          "@type": "HowToStep",
          "text": "Once fragrant, add curry leaves (2 sprigs) if using; roast until they turn crisp and shatter easily"
        },
        {
          "@type": "HowToStep",
          "text": "Add cumin seeds (2 tsp) and peppercorns (1 tsp) if using; roast until the cumin turns crunchy and fragrant, then turn off the flame"
        },
        {
          "@type": "HowToStep",
          "text": "With the flame off, stir in turmeric (¼ tsp) and hing (⅛ tsp) — residual heat blooms them without scorching"
        },
        {
          "@type": "HowToStep",
          "text": "Transfer everything to a wide plate and spread out to cool completely, at least 20–30 minutes"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Grind and store",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Once fully cooled, transfer everything to a blender or spice grinder jar"
        },
        {
          "@type": "HowToStep",
          "text": "Grind to a fine, even powder"
        },
        {
          "@type": "HowToStep",
          "text": "Let the ground powder cool completely — grinding generates heat, and trapping that warmth in a sealed jar invites moisture"
        },
        {
          "@type": "HowToStep",
          "text": "Store in an airtight glass or steel jar at room temperature; keeps well for about 3 months"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler note",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "This is a pantry ingredient, not a dish on its own, so there's no separate toddler portion here"
        },
        {
          "@type": "HowToStep",
          "text": "It's spicy — dried whole chilies and pepper — so whenever you use it later in a sambar, rasam, or anything else, pull her portion before this powder goes in, same as with any other chili step"
        },
        {
          "@type": "HowToTip",
          "text": "Stovetop pan for roasting, then a dry spice or coffee grinder for the final powder — no air fryer or pressure cooker needed here."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Yield: ~1 cup",
  "prepTime": "PT5M",
  "cookTime": "PT10M",
  "totalTime": "PT15M"
}
