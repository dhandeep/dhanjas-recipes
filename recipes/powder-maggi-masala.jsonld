{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Maggi Masala Powder",
  "description": "A unified spice blend for Maggi noodles and more — tuned so overlapping spices don't double up.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Powders & Chutneys",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Spice Blend, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "¾ cup Coriander powder",
    "3 tsp Roasted jeera (cumin) powder",
    "2 tbsp Red chili powder",
    "1 tbsp Turmeric (haldi)",
    "2 tbsp Chaat masala",
    "1½ tbsp Garam masala",
    "¾ tsp Dry ginger powder (soonth)",
    "1½ tsp Aamchur (mango powder)",
    "¾ tsp Black pepper powder",
    "1½ tsp Salt",
    "1½ tbsp Corn flour (cornstarch)",
    "1½ tsp Sugar",
    "½ tsp Hing"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Measure everything into one bowl",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Use a large dry bowl — everything goes in together"
        },
        {
          "@type": "HowToStep",
          "text": "Measure coriander powder (¾ cup) first — it's your visual anchor, everything else is much smaller relative to it"
        },
        {
          "@type": "HowToStep",
          "text": "Add roasted jeera (3 tsp), chili powder (2 tbsp), turmeric (1 tbsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Add chaat masala (2 tbsp) and garam masala (1½ tbsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Add ginger powder (¾ tsp), aamchur (1½ tsp), black pepper (¾ tsp), salt (1½ tsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Add corn flour (1½ tbsp), sugar (1½ tsp), hing (½ tsp)"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Mix until uniform",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Whisk or stir with a dry spoon for at least 1 minute"
        },
        {
          "@type": "HowToStep",
          "text": "No streaks of turmeric yellow or chili red should be visible when done"
        },
        {
          "@type": "HowToStep",
          "text": "Final color should be a warm reddish-brown — not orange, not dark brown"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Dry taste test",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Take a tiny pinch — rub between fingers and taste dry before jarring"
        },
        {
          "@type": "HowToStep",
          "text": "You should get: sour hit first, then warmth, then mild heat, savory salt undertone"
        },
        {
          "@type": "HowToStep",
          "text": "If something feels off, see the taste tuning notes below before transferring to jar"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Transfer to jar",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Use a completely dry 8 oz glass jar with a tight-sealing lid"
        },
        {
          "@type": "HowToStep",
          "text": "Funnel or spoon the blend in — tap to settle, don't pack it down"
        },
        {
          "@type": "HowToStep",
          "text": "Label with: Maggi Masala · date made · v1 — track adjustments batch to batch"
        },
        {
          "@type": "HowToStep",
          "text": "Never close the lid if anything is warm — moisture causes clumping"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler note",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Use ¼ tsp maximum per toddler serving — chaat masala and chili make this moderately spiced"
        },
        {
          "@type": "HowToStep",
          "text": "For her Maggi bowl: cook noodles plain, season her portion separately with ¼ tsp"
        },
        {
          "@type": "HowToStep",
          "text": "Stir in small cubed boiled carrot or potato for added nutrition and bulk"
        },
        {
          "@type": "HowToTip",
          "text": "Chaat masala and garam masala both carry pepper, cumin, ginger, and salt, so the standalone amounts of those four are dialed back to avoid doubling up. Aamchur replaces citric acid for a more natural sour note. Hing is added on top for Jain depth."
        },
        {
          "@type": "HowToTip",
          "text": "Maggi noodles: 1–1½ tsp per adult serving. Stir-fried vegetables or sabji: 1 tsp per 2 servings. Paneer marinade: 1½ tsp per 200g. Air-fryer paneer or peanuts: ¾–1 tsp per batch. Chaat sprinkle or raita seasoning: ½ tsp to taste."
        },
        {
          "@type": "HowToTip",
          "text": "Keep in a cool, dark spot away from the stove. Shelf life 3–4 months at room temperature, up to 6 months refrigerated in a sealed bag. Clumping means moisture got in — break it up and use within 2 weeks. Always scoop with a dry spoon, and label the jar with the date and \"v1\" to track adjustments."
        },
        {
          "@type": "HowToTip",
          "text": "Too spicy: stir in a little more coriander powder to dilute this jar; reduce chili next batch. Not sour enough: add more aamchur — it adds tang without extra salt. Tastes flat: add a touch more hing, the umami anchor here. Bitter aftertaste: usually the turmeric or over-toasted jeera — make sure roasted jeera is store-bought, not home-toasted past golden. Too salty: your chaat masala brand is likely running salty — use less per serving rather than fixing the jar."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Yield: ~8 oz jar",
  "prepTime": "PT5M",
  "totalTime": "PT5M"
}
