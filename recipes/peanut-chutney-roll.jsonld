{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Peanut Chutney Roti Roll",
  "description": "Whole wheat roti rolled around a coarse, spiced peanut chutney.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Breakfast",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Peanut · Quick, Quick, Night prep, High-protein, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "2 per adult Whole wheat roti",
    "2 tbsp Dry peanut chutney, per roti",
    "½ tsp Ghee or butter, per roti",
    "1 tsp Yogurt to loosen, per roti",
    "30–40g Paneer, thinly sliced or crumbled",
    "2–3 tbsp Cucumber, julienned",
    "2–3 tbsp Capsicum, thinly sliced",
    "1 tbsp Thick yogurt/hung curd, binder",
    "1 cup Roasted peanuts, skinned",
    "2 (adults) Dry red chili",
    "½ tsp Cumin seeds",
    "¼ tsp Hing",
    "½ tsp Salt",
    "1 tsp Lemon juice or aamchur"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Night Before",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Make the dry peanut chutney (step 1) — it keeps for weeks, so one batch covers many mornings"
        },
        {
          "@type": "HowToStep",
          "text": "Optionally make the dough for the rotis — keeps overnight in the fridge"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Make dry chutney (~10 min)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Pulse roasted peanuts (1 cup) in a dry blender — 5–6 short pulses until coarse crumble; do not over-blend into paste"
        },
        {
          "@type": "HowToStep",
          "text": "Add cumin seeds (½ tsp), hing (¼ tsp), salt (½ tsp) and aamchur (1 tsp); pulse 2–3 times — keep it coarse and sandy, not smooth"
        },
        {
          "@type": "HowToStep",
          "text": "Set aside (=¼ cup) in a small jar for the toddler now, before the chili goes in"
        },
        {
          "@type": "HowToStep",
          "text": "Add dry red chili (2) to the rest; pulse 2–3 more times to combine"
        },
        {
          "@type": "HowToStep",
          "text": "Store both in airtight jars — 2–3 weeks at room temperature"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Morning assembly",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat rotis (2) on tawa — 30 sec per side; smear ghee (½ tsp) on each while warm"
        },
        {
          "@type": "HowToStep",
          "text": "Spread dry chutney (2 tbsp) over each roti — if too dry, mix in yogurt (1 tsp) first"
        },
        {
          "@type": "HowToStep",
          "text": "Add filling: paneer (30–40g), cucumber (2–3 tbsp), capsicum (2–3 tbsp), bound with thick yogurt (1 tbsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Roll tightly and serve immediately or wrap in foil"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler version",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Use her chili-free chutney from the small jar"
        },
        {
          "@type": "HowToStep",
          "text": "Mix dry chutney (1 tsp) with yogurt (1 tbsp) to make a mild creamy spread"
        },
        {
          "@type": "HowToStep",
          "text": "Spread on soft roti (1) cut into strips or small pieces — easier for her to manage than a roll"
        },
        {
          "@type": "HowToStep",
          "text": "Add soft paneer pieces (a few soft pieces) or thinly sliced cucumber (a few thin slices) inside"
        },
        {
          "@type": "HowToTip",
          "text": "The chutney is the protein workhorse here — 2 tbsp of dry peanut chutney has ~7–8g protein. Double-layer it for more flavor and protein."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Serves 2 adults + toddler",
  "cookTime": "PT10M",
  "totalTime": "PT10M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "18–22 g",
    "description": "~18–22g protein per adult (2 rolls) — peanuts + wheat"
  }
}
