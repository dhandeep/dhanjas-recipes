{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Peanut Chutney Roti Roll",
  "description": "Whole wheat roti rolled around a coarse, spiced peanut chutney.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Breakfast",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Peanut · Quick, Quick, Night prep, High-protein, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "2 Whole wheat roti",
    "2 tbsp/roti Dry peanut chutney (pudi)",
    "½ tsp/roti Ghee or butter",
    "30–40g/roll Paneer, thinly sliced or crumbled",
    "2–3 tbsp Cucumber, julienned",
    "2–3 tbsp Capsicum, thinly sliced",
    "1 tbsp Thick yogurt/hung curd, binder",
    "1 cup Roasted peanuts, skinned",
    "2 (adults) Dry red chili",
    "½ tsp Cumin seeds",
    "¼ tsp Hing",
    "½ tsp Salt",
    "1 tsp Lemon juice or aamchur"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Night Before",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Make a batch of dry peanut chutney (shengdana chutney pudi) — keeps for weeks"
        },
        {
          "@type": "HowToStep",
          "text": "Mix chutney with yogurt or ghee to make a spreadable paste; refrigerate"
        },
        {
          "@type": "HowToStep",
          "text": "Optionally make roti dough — keeps overnight in the fridge"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Make dry chutney (~10 min)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Pulse roasted peanuts (1 cup) in a dry blender — 5–6 short pulses until coarse crumble; do not over-blend into paste"
        },
        {
          "@type": "HowToStep",
          "text": "Add dry red chili (2), cumin seeds (½ tsp), hing (¼ tsp), salt (½ tsp), aamchur (1 tsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Pulse 2–3 more times to combine — keep it coarse and sandy, not smooth"
        },
        {
          "@type": "HowToStep",
          "text": "Stores in an airtight jar for 2–3 weeks at room temperature"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Morning assembly",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat roti on tawa — 30 sec per side; smear ghee (½ tsp) while warm"
        },
        {
          "@type": "HowToStep",
          "text": "Spread dry chutney (2 tbsp) over roti — if too dry, mix a spoonful of yogurt into the chutney first"
        },
        {
          "@type": "HowToStep",
          "text": "Add filling: paneer (30–40g), cucumber, capsicum"
        },
        {
          "@type": "HowToStep",
          "text": "Roll tightly and serve immediately or wrap in foil"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler version",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Use chutney made without dry red chili — pulse peanuts with just cumin, hing, salt, aamchur"
        },
        {
          "@type": "HowToStep",
          "text": "Mix (1 tsp) chutney with yogurt (1 tbsp) to make a mild creamy spread"
        },
        {
          "@type": "HowToStep",
          "text": "Soft roti cut into strips or small pieces — easier for her to manage than a roll"
        },
        {
          "@type": "HowToStep",
          "text": "Add soft paneer pieces or thinly sliced cucumber inside"
        },
        {
          "@type": "HowToTip",
          "text": "The chutney is the protein workhorse here — 2 tbsp of dry peanut chutney has ~7–8g protein. Double-layer it for more flavor and protein."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Serves 2 adults + toddler",
  "cookTime": "PT10M",
  "totalTime": "PT10M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "18–22 g",
    "description": "~18–22g protein per adult (2 rolls) — peanuts + wheat"
  }
}
