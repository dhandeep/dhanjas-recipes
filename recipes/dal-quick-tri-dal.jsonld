{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Quick Tri-Dal",
  "description": "A light, everyday tempered dal — toor, urad, and chana, no soaking required.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Dal",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Tri-Dal · Meal Prep, Meal prep, Instant Pot, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "¾ cup Toor dal, split & dehusked",
    "½ cup Urad dal, split & dehusked",
    "¼ cup Chana dal, split, optional",
    "4 cups Water",
    "¾ tsp Turmeric",
    "1 tsp Salt",
    "2½ tbsp Ghee",
    "½ tsp Mustard seeds",
    "1 tsp Cumin seeds",
    "¼ tsp Hing",
    "1 tbsp Ginger, grated",
    "1 tsp Kashmiri chili powder",
    "1½ tbsp Lemon juice",
    "2 tbsp Cilantro, chopped",
    "Salt, to taste, as needed",
    "½ tsp Ghee, extra (toddler)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Rinse and pressure-cook the dals",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Rinse toor dal (¾ cup), urad dal (½ cup) and chana dal (¼ cup) together under water until it runs mostly clear — no soaking needed"
        },
        {
          "@type": "HowToStep",
          "text": "Add to the pressure cooker with water (4 cups), turmeric (¾ tsp) and salt (1 tsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Pressure cook 6–7 whistles on medium heat — the extra whistle or two makes up for skipping the soak, especially for the chana dal"
        },
        {
          "@type": "HowToStep",
          "text": "Let pressure release naturally, then whisk lightly with a ladle until the dal is smooth but still has a little texture"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler — pull before the tempering",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Scoop out a small bowl (about ¾ cup) of the plain cooked dal now, before tempering"
        },
        {
          "@type": "HowToStep",
          "text": "Stir in a small pat of ghee (½ tsp) for richness — her bowl stays plain and mild since it's set aside before the chili-spiced tempering is made"
        },
        {
          "@type": "HowToStep",
          "text": "Set the bowl aside"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Make the tempering (tadka)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat ghee (2½ tbsp) in a small pan over medium heat"
        },
        {
          "@type": "HowToStep",
          "text": "Add mustard seeds (½ tsp) and let them pop"
        },
        {
          "@type": "HowToStep",
          "text": "Add cumin seeds (1 tsp), sizzle 10 seconds"
        },
        {
          "@type": "HowToStep",
          "text": "Add hing (¼ tsp) and grated ginger (1 tbsp), sauté 20–30 seconds until fragrant"
        },
        {
          "@type": "HowToStep",
          "text": "Add Kashmiri chili powder (1 tsp), stir for just a few seconds so it doesn't scorch"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Finish, then store for meal prep",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Pour the hot tempering over the remaining dal (the toddler portion has already been set aside) and stir well"
        },
        {
          "@type": "HowToStep",
          "text": "Adjust consistency with water (as needed) — this dal should be pourable, not thick like a gravy"
        },
        {
          "@type": "HowToStep",
          "text": "Simmer 3–4 minutes on low heat so the flavors settle"
        },
        {
          "@type": "HowToStep",
          "text": "Stir in lemon juice (1½ tbsp) and adjust salt (as needed)"
        },
        {
          "@type": "HowToStep",
          "text": "Garnish servings with chopped cilantro (2 tbsp) just before eating — store the rest without it"
        },
        {
          "@type": "HowToStep",
          "text": "Cool to room temperature, then refrigerate in an airtight container — keeps 4 days"
        },
        {
          "@type": "HowToStep",
          "text": "Reheat on the stovetop with a splash of water to loosen; add the garnish fresh after reheating"
        },
        {
          "@type": "HowToTip",
          "text": "Stovetop pressure cooker works straight from rinsed dal — no soak needed since these are all split and dehusked; give it one or two extra whistles versus a soaked-dal recipe to make sure the chana dal fully softens. Chana dal is optional — skip it and use 1 cup toor dal + ½ cup urad dal instead (same total volume), dropping back to 5–6 whistles. This is a thinner, everyday dal, not a gravy — meant for rice or roti as a daily-rotation option alongside the richer dal makhani. Ginger is added generously here since it's the main warming element in a light, Jain dal like this."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "cookTime": "PT30M",
  "totalTime": "PT30M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "10–12 g",
    "description": "~10–12g protein per adult serving — from toor, urad & chana dal"
  }
}
