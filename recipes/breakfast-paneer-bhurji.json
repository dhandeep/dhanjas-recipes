{
  "$schema": "https://dhanjas.com/schema/recipe.schema.json",
  "format": 3,
  "slug": "breakfast-paneer-bhurji",
  "category": "breakfast",
  "title": "Paneer Bhurji",
  "subtitle": "Creamy scrambled paneer with tomato and capsicum — a fast, high-protein weekday breakfast.",
  "badges": [
    "Jain Vegetarian",
    "Toddler-adapted"
  ],
  "labels": [
    "Paneer"
  ],
  "meta": [
    "Night prep: optional 5 min",
    "Morning: 20 min",
    "Serves 2 adults + toddler"
  ],
  "protein": "~28–32g protein per adult serving",
  "nightPrep": {
    "label": "Night Before (optional)",
    "items": [
      "Crumble the {@paneer} and refrigerate",
      "Chop {@capsicum}, {@tomatoes} and {@coriander}; refrigerate in a small container"
    ]
  },
  "ingredientGroups": [
    {
      "label": "Main",
      "items": [
        {"id": "paneer", "name": "Paneer, crumbled", "short": "paneer", "amount": "400g", "portions": {"toddler": "100g", "main": "rest"}},
        {"id": "tomatoes", "name": "Tomatoes, finely chopped (2 medium)", "short": "tomatoes", "amount": "1 cup", "portions": {"toddler": "2 tbsp", "main": "rest"}},
        {"id": "capsicum", "name": "Capsicum, diced (1 medium)", "short": "capsicum", "amount": "¾ cup", "portions": {"toddler": "2 tbsp", "main": "rest"}},
        {"id": "ginger", "name": "Fresh ginger, grated", "short": "ginger", "amount": "1½ tsp"},
        {"id": "green-chili", "name": "Green chili, chopped", "short": "green chili", "amount": "1–2 (adults)"},
        {"id": "ghee", "name": "Ghee or butter", "short": "ghee", "amount": "2 tbsp + ½ tsp", "portions": {"toddler": "½ tsp", "main": "2 tbsp"}},
        {"id": "potato", "name": "Boiled potato, optional (toddler only)", "short": "boiled potato", "amount": "½", "portions": {"toddler": "½"}}
      ]
    },
    {
      "label": "Spices",
      "items": [
        {"id": "cumin", "name": "Cumin seeds", "short": "cumin seeds", "amount": "1 tsp", "portions": {"toddler": "a pinch", "main": "1 tsp"}},
        {"id": "hing", "name": "Hing", "short": "hing", "amount": "¼ tsp"},
        {"id": "turmeric", "name": "Turmeric", "short": "turmeric", "amount": "¼ tsp", "portions": {"toddler": "a pinch", "main": "¼ tsp"}},
        {"id": "chili-powder", "name": "Kashmiri red chili powder", "short": "red chili powder", "amount": "½ tsp"},
        {"id": "coriander-powder", "name": "Coriander powder", "short": "coriander powder", "amount": "1 tsp"},
        {"id": "cumin-powder", "name": "Cumin powder", "short": "cumin powder", "amount": "½ tsp"},
        {"id": "garam-masala", "name": "Garam masala", "short": "garam masala", "amount": "¼ tsp"},
        {"id": "kasuri-methi", "name": "Kasuri methi, crushed", "short": "kasuri methi", "amount": "1 tsp"}
      ]
    },
    {
      "label": "Finish & serve",
      "items": [
        {"id": "salt", "name": "Salt", "short": "salt", "amount": "to taste", "portions": {"toddler": "a pinch", "main": "to taste"}},
        {"id": "coriander", "name": "Fresh coriander, chopped", "short": "coriander", "amount": "2 tbsp"},
        {"id": "lemon", "name": "Lemon juice, optional", "short": "lemon juice", "amount": "½ tsp"},
        {"id": "roti", "name": "Whole wheat roti or toast", "short": "roti", "amount": "2 per adult", "portions": {"adult": "2 per adult", "toddler": "1"}}
      ]
    }
  ],
  "method": [
    {
      "type": "toddler",
      "label": "Toddler portion first (~5 min)",
      "items": [
        "Heat a small pan on low; add {@ghee:toddler|butter}",
        "Add {@cumin:toddler}, let splutter",
        "Add {@tomatoes:toddler} and {@capsicum:toddler} from the chopped batch; cook 2 min until soft",
        "Add {@paneer:toddler}, {@turmeric:toddler} and {@salt:toddler}; stir 1–2 min — keep moist",
        "Optional: mash in {@potato:toddler} for extra calories",
        "Serve with {@roti:toddler|soft roti or toast soldiers}"
      ]
    },
    {
      "type": "step",
      "title": "Build the base",
      "items": [
        "Heat {@ghee:main} in a wide pan on medium-high",
        "Add {@cumin:main}; splutter 20 sec",
        "Add {@hing} and {@ginger}; stir 30 sec",
        "Add {@green-chili}; cook 20 sec",
        "Add {@tomatoes:main|remaining tomatoes}; cook 4–5 min until oil separates",
        "Add {@capsicum:main|remaining capsicum}; stir-fry 2 min, keep slight crunch"
      ]
    },
    {
      "type": "step",
      "title": "Spice and finish",
      "items": [
        "Add {@turmeric:main}, {@chili-powder}, {@coriander-powder}, {@cumin-powder} and {@salt:main}; stir 30 sec",
        "Add {@paneer:main|remaining paneer}; fold gently — don't mash",
        "Cook 2–3 min; add {@garam-masala} and {@kasuri-methi}",
        "Finish with {@lemon}; garnish with {@coriander}",
        "Serve with {@roti:adult|roti or toast}"
      ]
    },
    {
      "type": "tip",
      "label": "Tip",
      "text": "High heat when cooking tomatoes is key — it develops flavor fast. Don't overcook after adding paneer; it should stay soft and moist."
    }
  ],
  "tags": [
    "Night prep",
    "High-protein"
  ],
  "added": "2026-09-06"
}
