{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Rava Upma with Peanuts",
  "description": "A quick semolina upma, roasted golden and studded with peanuts.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Breakfast",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Semolina, Quick, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "1 cup Rava (semolina / sooji)",
    "⅓ cup Raw peanuts",
    "2¾ cups Water",
    "1 tsp Fresh ginger, grated",
    "1–2 (adults) Green chili, slit",
    "2 tbsp Ghee",
    "1 tsp Mustard seeds",
    "½ tsp Cumin seeds",
    "¼ tsp Hing",
    "8–10 Curry leaves",
    "10–12 Cashews, optional",
    "½ cup Capsicum, finely diced",
    "1 medium Tomato, chopped",
    "¼ tsp Turmeric",
    "Salt, to taste",
    "1 tsp Lemon juice",
    "2 tbsp Fresh coriander",
    "1–2 tbsp Boiled potato, finely diced (toddler only)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Dry roast rava and peanuts",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat a wide pan on medium; add rava (1 cup) — dry roast 3–4 min, stirring constantly until lightly golden and fragrant"
        },
        {
          "@type": "HowToStep",
          "text": "Remove and set aside"
        },
        {
          "@type": "HowToStep",
          "text": "In the same pan, dry roast peanuts (⅓ cup) on medium 3–4 min until skins blister; set aside"
        },
        {
          "@type": "HowToStep",
          "text": "Let the peanuts cool, then rub off any loose skins"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Tempering",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat ghee (2 tbsp) in the pan on medium"
        },
        {
          "@type": "HowToStep",
          "text": "Add mustard seeds (1 tsp) — splutter; add cumin seeds (½ tsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Add hing (¼ tsp), curry leaves (8–10), cashews (10–12) if using — stir 30 sec"
        },
        {
          "@type": "HowToStep",
          "text": "Add ginger (1 tsp) — cook 20 sec"
        },
        {
          "@type": "HowToStep",
          "text": "Add capsicum (½ cup) and tomato (1 medium); cook 2 min"
        },
        {
          "@type": "HowToStep",
          "text": "Add turmeric (¼ tsp) and salt (to taste); stir"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler — pull portion here (before chili)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Scoop out the cooked vegetables (3–4 tbsp) into a separate small pan now — before adding green chili to the main pan"
        },
        {
          "@type": "HowToStep",
          "text": "Add water (¼ cup) and roasted rava (3 tbsp) to her pan; cook on low, stirring until soft and water absorbed"
        },
        {
          "@type": "HowToStep",
          "text": "Stir in crushed peanuts (1 tsp) or ghee (a drop)"
        },
        {
          "@type": "HowToStep",
          "text": "Optional: add finely diced boiled potato (1–2 tbsp) for extra bulk"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Add chili and cook upma",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add green chili (1–2) to the adult pan; cook 20 sec"
        },
        {
          "@type": "HowToStep",
          "text": "Bring water (2½ cups) to a boil in a separate pot; pour into the tempering pan carefully"
        },
        {
          "@type": "HowToStep",
          "text": "Reduce heat to medium-low; slowly add remaining roasted rava (¾ cup + 1 tbsp) while stirring continuously to avoid lumps"
        },
        {
          "@type": "HowToStep",
          "text": "Stir in remaining roasted peanuts (5 tbsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Cover and cook 3–4 min on low until rava absorbs all water"
        },
        {
          "@type": "HowToStep",
          "text": "Finish with lemon juice (1 tsp) and coriander (2 tbsp)"
        },
        {
          "@type": "HowToTip",
          "text": "Roasting rava before cooking is non-negotiable — it prevents lumpy upma. Add water slowly and stir constantly as it goes in."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Serves 2 adults + toddler",
  "cookTime": "PT20M",
  "totalTime": "PT20M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "14–16 g",
    "description": "~14–16g protein per adult serving (peanuts are the primary source)"
  }
}
