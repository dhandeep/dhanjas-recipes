{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Hung Curd Protein Bowl",
  "description": "A five-minute high-protein bowl, built two ways — sweet or savory.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Breakfast",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Dairy, Quick, Night prep, High-protein, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "500g Full-fat yogurt, to hang",
    "2 tbsp Hemp seeds, per bowl",
    "2 tbsp Pumpkin seeds, per bowl",
    "8–10 Almonds, chopped, per bowl",
    "4–5 Walnut halves, per bowl",
    "a handful Toast or makhana, to serve",
    "1 tsp Jaggery powder",
    "½ cup Seasonal fruit",
    "¼ tsp Roasted cumin powder",
    "a pinch Black salt (kala namak)",
    "¼ cup Cucumber, finely diced",
    "1 tbsp Coriander leaves",
    "⅓ cup Full-fat yogurt, not hung",
    "¼ cup Banana or soft fruit, mashed",
    "1 small Boiled potato, optional"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Night Before — essential",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Hang the yogurt (step 1) — 5 min of work, but it needs the whole night in the fridge"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Hang the curd (night before)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Line a colander with muslin cloth and set it over a deep bowl"
        },
        {
          "@type": "HowToStep",
          "text": "Pour in yogurt (500g); tie the cloth and hang it over the bowl in the fridge overnight"
        },
        {
          "@type": "HowToStep",
          "text": "By morning it's thick hung curd with ~2× the protein density"
        },
        {
          "@type": "HowToStep",
          "text": "Save the drained whey for roti dough"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Morning assembly",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Unwrap the hung curd (~1½ cups) — should be thick like labneh"
        },
        {
          "@type": "HowToStep",
          "text": "Divide into two adult bowls (=~¾ cup each)"
        },
        {
          "@type": "HowToStep",
          "text": "Sweet: stir in jaggery powder (1 tsp), add fruit (½ cup), top with hemp seeds (2 tbsp), pumpkin seeds (2 tbsp), almonds (8–10) and walnuts (4–5)"
        },
        {
          "@type": "HowToStep",
          "text": "Savory: stir in kala namak (a pinch) and cumin (¼ tsp), top with cucumber (¼ cup), coriander (1 tbsp), hemp seeds (2 tbsp), pumpkin seeds (2 tbsp), almonds (8–10) and walnuts (4–5)"
        },
        {
          "@type": "HowToStep",
          "text": "Serve multigrain toast or makhana (a handful) alongside"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler bowl",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Use regular full-fat yogurt (⅓ cup) (not hung) — easier texture"
        },
        {
          "@type": "HowToStep",
          "text": "Add mashed banana or soft fruit (¼ cup)"
        },
        {
          "@type": "HowToStep",
          "text": "Top with finely ground almonds (1 tsp) — no whole nuts (choking hazard)"
        },
        {
          "@type": "HowToStep",
          "text": "Sweeten with jaggery powder (a pinch)"
        },
        {
          "@type": "HowToStep",
          "text": "Optional: mash in boiled potato (1 small) for extra calories"
        },
        {
          "@type": "HowToTip",
          "text": "Hung curd yields ~10–12g protein per 100g. Hemp seeds add 10g per 3 tbsp. Together with nuts you're at 22–28g with zero cooking."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Serves 2 adults + toddler",
  "prepTime": "PT5M",
  "cookTime": "PT5M",
  "totalTime": "PT10M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "22–28 g",
    "description": "~22–28g protein per adult bowl"
  }
}
