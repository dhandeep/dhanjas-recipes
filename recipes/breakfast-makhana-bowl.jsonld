{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Makhana Trail Mix Bowl",
  "description": "A crisp, no-cook bowl of roasted fox nuts, nuts, and seeds.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Breakfast",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "No-cook · Snack, Quick, Night prep, High-protein, No-cook, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "1 cup Roasted makhana (fox nuts)",
    "8–10 Almonds",
    "4–5 halves Walnuts, broken",
    "1 tbsp Pumpkin seeds",
    "1 tbsp Hemp seeds",
    "1 tbsp Raisins or dried cranberries",
    "½ cup Full-fat yogurt or hung curd",
    "½ cup Fresh fruit",
    "1 tsp Honey",
    "3–4 cups Makhana (fox nuts), raw",
    "1 tsp Ghee",
    "a pinch Salt",
    "a pinch Black pepper, optional"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Batch Roast (lasts 1–2 weeks)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Roast makhana in a dry pan on low heat 8–10 min until crisp; season lightly with ghee and salt"
        },
        {
          "@type": "HowToStep",
          "text": "Cool completely before storing in an airtight jar — stays crisp for 2 weeks"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Roast makhana (batch, not daily)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat a wide heavy pan on low — no oil yet"
        },
        {
          "@type": "HowToStep",
          "text": "Add makhana (3–4 cups); dry roast, stirring constantly, 8–10 min until they feel light and crisp when pressed"
        },
        {
          "@type": "HowToStep",
          "text": "Add ghee (1 tsp), salt (pinch), black pepper (a pinch) if using; toss well for 1 min"
        },
        {
          "@type": "HowToStep",
          "text": "Cool completely on a plate; store in an airtight jar once fully cool"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Morning assembly",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add roasted makhana (1 cup) to bowl"
        },
        {
          "@type": "HowToStep",
          "text": "Add almonds (8–10), walnuts (4–5 halves), pumpkin seeds (1 tbsp), hemp seeds (1 tbsp), raisins (1 tbsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Serve yogurt (½ cup) and fruit (½ cup) alongside for dipping, with a drizzle of honey (1 tsp) if desired — keeps the makhana crisp"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler bowl",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Makhana is safe — soft enough once chewed, not a choking risk at age 2"
        },
        {
          "@type": "HowToStep",
          "text": "Give whole makhana (¼ cup) — she'll enjoy the crunch"
        },
        {
          "@type": "HowToStep",
          "text": "Serve with yogurt for dipping — makes it interactive and fun"
        },
        {
          "@type": "HowToStep",
          "text": "Grind almonds finely (1 tsp) before adding; skip whole walnuts (too hard to chew)"
        },
        {
          "@type": "HowToStep",
          "text": "Add soft fruit pieces (¼ cup) to round it out"
        },
        {
          "@type": "HowToTip",
          "text": "Serve the yogurt and makhana in separate bowls — pouring yogurt over makes makhana go soggy fast. Dip and eat as you go."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Serves 2 adults + toddler",
  "cookTime": "PT3M",
  "totalTime": "PT3M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "16–20 g",
    "description": "~16–20g protein per adult bowl (makhana + nuts + seeds)"
  }
}
