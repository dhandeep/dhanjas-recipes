{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Makhana Trail Mix Bowl",
  "description": "A crisp, no-cook bowl of roasted fox nuts, nuts, and seeds.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Breakfast",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "No-cook · Snack, Quick, Night prep, High-protein, No-cook, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "3–4 cups Makhana (fox nuts), raw",
    "1 tsp Ghee",
    "a pinch Salt",
    "1 cup per bowl Roasted makhana",
    "8–10 per bowl Almonds",
    "4–5 halves per bowl Walnuts, broken",
    "1 tbsp per bowl Pumpkin seeds",
    "1 tbsp per bowl Hemp seeds",
    "1 tbsp per bowl Raisins or dried cranberries",
    "a pinch Black pepper, optional (adults)",
    "½ cup per bowl Full-fat yogurt or hung curd",
    "½ cup per bowl Fresh fruit",
    "1 tsp per bowl Jaggery powder, optional"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Batch Roast (lasts 1–2 weeks)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Roast the makhana ahead (step 1) — one batch lasts 1–2 weeks"
        },
        {
          "@type": "HowToStep",
          "text": "Cool completely before storing in an airtight jar — stays crisp for 2 weeks"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Roast makhana (batch, not daily)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat a wide heavy pan on low — no oil yet"
        },
        {
          "@type": "HowToStep",
          "text": "Add makhana (3–4 cups); dry roast, stirring constantly, 8–10 min until they feel light and crisp when pressed"
        },
        {
          "@type": "HowToStep",
          "text": "Add ghee (1 tsp) and salt (a pinch); toss well for 1 min — no pepper, so the jar suits the toddler too"
        },
        {
          "@type": "HowToStep",
          "text": "Cool completely on a plate; store in an airtight jar once fully cool"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler bowl",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Makhana is safe — soft enough once chewed, not a choking risk at age 2"
        },
        {
          "@type": "HowToStep",
          "text": "Give whole roasted makhana (¼ cup) — she'll enjoy the crunch"
        },
        {
          "@type": "HowToStep",
          "text": "Serve with yogurt (a small bowl) for dipping — makes it interactive and fun"
        },
        {
          "@type": "HowToStep",
          "text": "Grind almonds (1 tsp) finely before adding; skip whole walnuts (too hard to chew)"
        },
        {
          "@type": "HowToStep",
          "text": "Add soft fruit pieces (¼ cup)"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Morning assembly (adults)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add roasted makhana (1 cup) to each bowl"
        },
        {
          "@type": "HowToStep",
          "text": "Add almonds (8–10), walnuts (4–5 halves), pumpkin seeds (1 tbsp), hemp seeds (1 tbsp), raisins (1 tbsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Sprinkle black pepper (a pinch) over and toss, if using"
        },
        {
          "@type": "HowToStep",
          "text": "Serve yogurt (½ cup) and fruit (½ cup) alongside for dipping, with jaggery powder (1 tsp) if desired — keeps the makhana crisp"
        },
        {
          "@type": "HowToTip",
          "text": "Serve the yogurt and makhana in separate bowls — pouring yogurt over makes makhana go soggy fast. Dip and eat as you go."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Serves 2 adults + toddler",
  "cookTime": "PT3M",
  "totalTime": "PT3M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "16–20 g",
    "description": "~16–20g protein per adult bowl (makhana + nuts + seeds)"
  }
}
