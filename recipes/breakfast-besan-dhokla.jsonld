{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Instant Besan Dhokla",
  "description": "A Sunday-batch steamed chickpea cake with a tangy mustard-seed tempering.",
  "author": {
    "@type": "Organization",
    "name": "dhanjas.com"
  },
  "recipeCategory": "Breakfast",
  "recipeCuisine": "Indian (Jain)",
  "suitableForDiet": "https://schema.org/VegetarianDiet",
  "keywords": "Chickpea · Batch, Night prep, Meal prep, High-protein, Instant Pot, Jain Vegetarian, Toddler-adapted",
  "recipeIngredient": [
    "2 cups Besan (chickpea flour)",
    "½ cup Full-fat yogurt",
    "¾ cup Water",
    "1 tsp Fresh ginger, grated",
    "1 tsp (adults) Green chili paste",
    "2 tbsp Lemon juice",
    "1 tsp Sugar",
    "1 tsp Salt",
    "½ tsp Turmeric",
    "¼ tsp Hing",
    "2 tsp total Eno fruit salt, plain",
    "2 tbsp Oil",
    "1 tsp Mustard seeds",
    "10–12 Curry leaves",
    "2 (adults) Green chili, slit",
    "3 tbsp Water",
    "1 tsp Sugar",
    "1 tbsp Lemon juice",
    "2 tbsp Fresh coriander, chopped",
    "2 tbsp Fresh coconut, grated, optional"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Batch on Sunday",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Make the full batch Sunday — keeps refrigerated 4–5 days"
        },
        {
          "@type": "HowToStep",
          "text": "Reheat: microwave with a sprinkle of water, 60–90 sec, covered loosely"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Make batter",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Whisk besan (2 cups) with yogurt (½ cup) and water (¾ cup) — no lumps"
        },
        {
          "@type": "HowToStep",
          "text": "Add ginger (1 tsp), turmeric (½ tsp), hing (¼ tsp), lemon juice (2 tbsp), sugar (1 tsp), salt (1 tsp)"
        },
        {
          "@type": "HowToStep",
          "text": "Split batter now — remove ¾ cup into a separate dish for toddler before adding chili"
        },
        {
          "@type": "HowToStep",
          "text": "Add green chili paste (1 tsp) to adult batter only; rest both 5 min"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler batch",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Her ¾ cup is already set aside — mild, chili-free"
        },
        {
          "@type": "HowToStep",
          "text": "Add Eno (½ tsp), pour into greased katori; steam 8–10 min (thinner layer)"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Steam (Instant Pot)",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add water (1½ cups) to IP inner pot; place trivet"
        },
        {
          "@type": "HowToStep",
          "text": "Add Eno (1½ tsp) to adult batter — stir quickly until foamy; do not overmix"
        },
        {
          "@type": "HowToStep",
          "text": "Pour immediately into greased tin (~1 inch layer); place on trivet"
        },
        {
          "@type": "HowToStep",
          "text": "Steam 12–15 min with valve open — toothpick should come out clean"
        },
        {
          "@type": "HowToStep",
          "text": "Cool 5 min before cutting"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Tempering",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat oil (2 tbsp); add mustard seeds (1 tsp) — splutter"
        },
        {
          "@type": "HowToStep",
          "text": "Add curry leaves (10–12) and green chili (2, slit)"
        },
        {
          "@type": "HowToStep",
          "text": "Add water (3 tbsp), sugar (1 tsp), lemon juice (1 tbsp); quick boil"
        },
        {
          "@type": "HowToStep",
          "text": "Pour evenly over cut dhokla; let soak 5 min"
        },
        {
          "@type": "HowToStep",
          "text": "Garnish with coriander (2 tbsp) and coconut (2 tbsp)"
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "👶 Toddler reheat",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Reheat her pieces separately — microwave (45 sec) with a splash of water"
        },
        {
          "@type": "HowToStep",
          "text": "Serve in small pieces; pair with plain yogurt or warm milk"
        },
        {
          "@type": "HowToTip",
          "text": "Add Eno at the last second and get batter into the steamer within 60 seconds — the reaction is fast. Waiting = flat dhokla."
        }
      ]
    }
  ],
  "datePublished": "2026-09-07",
  "recipeYield": "Makes ~20 pieces",
  "prepTime": "PT40M",
  "cookTime": "PT5M",
  "totalTime": "PT45M",
  "nutrition": {
    "@type": "NutritionInformation",
    "proteinContent": "16–18 g",
    "description": "~16–18g protein per adult serving"
  }
}
